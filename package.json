{
  "name": "translation-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode client --host 127.0.0.1",
    "build": "npm run typecheck && vite build --mode client",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:sources && npm run test:database && npm run test:worker && npm run test:client",
    "test:sources": "node --experimental-strip-types --test tests/sources.test.ts tests/sourceCollector.test.ts tests/imageHash.test.ts tests/candidates.test.ts tests/creativeMatch.test.ts",
    "test:database": "node --experimental-strip-types --test tests/tursoDatabase.test.ts",
    "test:worker": "node --experimental-strip-types --test tests/nodeWorker.test.ts tests/workerRuntime.test.ts tests/creativeGrouping.test.ts tests/crashReports.test.ts",
    "test:client": "node --experimental-strip-types --test tests/boardClient.test.ts",
    "turso:migrate": "node --experimental-strip-types scripts/tursoDatabase.ts",
    "test:live": "node --experimental-strip-types --test tests/liveWorker.test.ts",
    "worker": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/worker.ts",
    "creative:aliases": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/creativeAliases.ts",
    "creative:review": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/creativeReview.ts",
    "creative:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/creativeCheck.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@libsql/client": "^0.18.0",
    "@sentry/node": "^11.12.0",
    "@sentry/react": "^11.12.0",
    "node-html-parser": "^9.0.4",
    "puppeteer-core": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@sentry/bundler-plugins": "^11.12.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
