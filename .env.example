# Final database: Turso libSQL. Use a write token only in the Node worker.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# Local integration: TURSO_DATABASE_URL=file:/absolute/path/board.db
# Web API (/api/board): database-scoped read-only token (authorization=read-only).
# Server-only: put it in .env.client.local or Vercel's server environment, never with a VITE_ prefix.
TURSO_READ_TOKEN=

# Public site origin for absolute Open Graph/Twitter image URLs.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when unset.
VITE_SITE_URL=

# GA4 measurement ID. Set in Vercel's Production environment and redeploy.
# Only included when VERCEL_ENV=production; local and preview builds omit it.
VITE_GA_MEASUREMENT_ID=

# Sentry DSN for the web project. Set in Vercel's Production environment only.
VITE_SENTRY_DSN=
# Sentry organization token for uploading web source maps at build time.
# Vercel Production only, marked Sensitive. Never commit it.
SENTRY_AUTH_TOKEN=

# Worker-only Jev title matching (probability >= 0.95).
JEV_KEY=

# Optional worker-only Healthchecks success pings, one check per board and source.
# Translation board:
HEALTHCHECKS_ARCA_PING_URL=
HEALTHCHECKS_DC_PING_URL=
# Creative board:
HEALTHCHECKS_CREATIVE_ARCA_PING_URL=
HEALTHCHECKS_CREATIVE_DC_PING_URL=

# Optional worker-only Sentry crash reports (worker project DSN).
SENTRY_DSN=
